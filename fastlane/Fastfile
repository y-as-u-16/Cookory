default_platform(:ios)

APP_IDENTIFIER = "com.egi-engineer.Cookory".freeze
PROJECT = "Cookory.xcodeproj".freeze
SCHEME = "Cookory".freeze

# 公開リポジトリのため Team ID はソースへ書かず環境変数から読む。
def team_id
  ENV.fetch("DEVELOPMENT_TEAM")
end

# API キーは複数の lane で使うため一箇所で組み立てる。
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
    duration: 1200,
  )
end

platform :ios do
  desc "TestFlight の最新ビルド番号 + 1 を返す"
  desc "ビルド番号は CI の実行回数から採らない。re-run で値が変わらず、"
  desc "同じ番号で再アップロードして必ず弾かれるため。"
  lane :next_build_number do
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      # TestFlight に1件も無い（初回配信前）と例外になるため 0 を起点にする
      initial_build_number: 0,
    )
    next_number = latest + 1
    UI.message("次のビルド番号: #{next_number}")
    # 標準出力は fastlane 自身のログ（完了メッセージ等）が混ざるため、
    # 呼び出し側はファイル経由で受け取る。
    out = ENV["BUILD_NUMBER_OUTPUT"]
    File.write(out, next_number) if out
    next_number
  end

  desc "証明書とプロファイルを作成して certificates リポジトリへ保存する"
  desc "ローカルの Mac で最初に一度だけ実行する。CI は readonly のため作成できない。"
  lane :setup_certificates do
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: asc_api_key,
      readonly: false,
    )
  end

  desc "TestFlight へ配信する"
  lane :beta do
    # 一時キーチェーンを作る。これが無いと match が
    # ロック解除ダイアログを待って無限にハングする（エラーにならない）。
    setup_ci if is_ci

    api_key = asc_api_key

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      readonly: is_ci,
    )

    build_number = ENV["BUILD_NUMBER"]
    UI.user_error!("BUILD_NUMBER が指定されていません") if build_number.to_s.empty?

    # このリポジトリは DEVELOPMENT_TEAM を空にして公開しているため、
    # 署名前に Team ID とプロファイルを注入する必要がある。
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
      .fetch(APP_IDENTIFIER)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      targets: [SCHEME],
      build_configurations: ["Release"],
      team_id: team_id,
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
    )

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: build_number,
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ipa",
      export_team_id: team_id,
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      # 暗号化に関する輸出コンプライアンス。外部通信をしないアプリなので false。
      # これを渡すと App Store Connect でのコンプライアンス回答が不要になる。
      uses_non_exempt_encryption: false,
      # テスターグループへの自動配布はしない。配布には TestFlight の
      # ローカライズ情報（説明・連絡先）が必須で、未設定だと
      # betaAppLocalizations not found でアップロード自体が失敗する。
      # 処理完了を待つと macOS ランナーの課金が伸びる。
      # 失敗した場合は App Store Connect からメールで通知される。
      skip_waiting_for_build_processing: true,
    )

    # 署名設定の書き換えをコミットさせない。公開リポジトリに Team ID が
    # 紛れ込むのを防ぐため、CI では毎回捨てる。
    reset_git_repo(files: [PROJECT], force: true) if is_ci
  end

  desc "掲載テキストとスクリーンショットをまとめて更新する"
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      # ビルドは CD が TestFlight へ上げるため、ここでは触らない。
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
    )
  end

  desc "掲載テキストだけを更新する（スクショは触らない）"
  desc "文言の微調整を繰り返すときはこちらが速い。"
  lane :upload_text_only do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
    )
  end

  desc "スクリーンショットだけを更新する"
  desc "deliver ではなく tools/appstore/sync_screenshots.rb を使うこと。"
  desc "deliver の overwrite_screenshots は削除の反映を待たずに送り、毎回二重に登録される。"
  lane :upload_screenshots_only do
    UI.user_error!(
      "bundle exec ruby tools/appstore/sync_screenshots.rb を使ってください"
    )
  end
end
